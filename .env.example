# Optional private path to the existing local Zetaris distribution .env.
# Values are read server-side. Never copy that file into Git.
ZETARIS_PLATFORM_ENV_FILE=
# Alternatively set these existing-account credentials here.
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
# Nightshift Console Runtime access token, never NVIDIA provider key.
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=meterless/auto
# Loopback ports only. App defaults to 4317, Zetaris UI3000, Nightshift8088.
ORDER_EVIDENCE_PORT=4317
